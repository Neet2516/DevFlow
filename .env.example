# ==========================================
# DevFlow Environment Configuration Example
# Copy this file to .env and adjust values
# ==========================================

# Database Configuration
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5433/devflow?schema=public"

# Docker Compose Production Variables
POSTGRES_USER=devflow
POSTGRES_PASSWORD=devflowpassword
POSTGRES_DB=devflow

# Security & Authentication
# Secret key used for JWT signing/verification in API & Auth packages
JWT_SECRET=supersecretjwtkey_changeme_in_production

# Redis Connection
REDIS_URL=redis://localhost:6379

# Service Core URLs
API_URL=http://localhost:3000
WS_URL=ws://localhost:3003
PORT=3000

# Microservices URLs (internal/gateway routing defaults)
PIPELINE_SERVICE_URL=http://localhost:3001
EXECUTION_SERVICE_URL=http://localhost:3002
WS_SERVICE_URL=http://localhost:3003
AI_ANALYZER_SERVICE_URL=http://localhost:3004
NOTIF_SERVICE_URL=http://localhost:3005
GITHUB_ADAPTER_URL=http://localhost:3006
AUDIT_SERVICE_URL=http://localhost:3007

# Microservices Listening Ports (Optional overrides)
AI_ANALYZER_PORT=3004
AUDIT_PORT=3007
GITHUB_ADAPTER_PORT=3006
NOTIFICATION_PORT=3005
WS_PORT=3003

# Dashboard Frontend (Vite Environment Variables)
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3003

# GitHub Adapter & Webhook Integration (Optional)
GITHUB_WEBHOOK_SECRET=
DEFAULT_PIPELINE_ID=

# Notifications (Optional)
SLACK_WEBHOOK_URL=

# Monitoring & Administration
GRAFANA_PASSWORD=devflow
